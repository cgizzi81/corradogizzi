# ─────────────────────────────────────────────────────────────────────
#  Variabili per la risposta automatica ai preventivi — corradogizzi.it
#
#  Netlify → Site configuration → Environment variables → Import from
#  a .env file, e carica questo file.
#
#  ATTENZIONE: sostituisci <la-password-della-casella> prima di caricarlo, e
#  NON salvare questo file dentro la cartella del sito.
# ─────────────────────────────────────────────────────────────────────

# Server di posta della casella info@ (Aruba)
SMTP_HOST=smtps.aruba.it
SMTP_PORT=465

# La casella da cui parte l'email al paziente
SMTP_USER=info@corradogizzi.it

# ⚠️ Da sostituire. Dopo l'import, marca SOLO questa variabile come
#    "Contains secret values" nel pannello.
SMTP_PASS=<la-password-della-casella>

# Copia di ogni preventivo inviato. Se la togli, la copia va a SMTP_USER.
COPIA_A=corradogizzi@gmail.com

# ⚠️ Interruttore di sicurezza: con 1 la funzione calcola il preventivo e
#    lo scrive nei log, ma NON invia nulla. Lascialo a 1 per il primo
#    collaudo; quando i log sono corretti, cancella questa variabile.
PREVENTIVI_OFF=1
