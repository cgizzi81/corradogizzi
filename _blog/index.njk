<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <!-- Favicon. Percorsi assoluti dalla radice: valgono uguali per le pagine in
       sottocartella, senza doverci anteporre ../ -->
  <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48">
  <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg">
  <!-- Google mostra la favicon nei risultati solo se trova un quadrato di almeno
       48px, preferibilmente multiplo di 48: senza queste due righe leggeva solo
       il sizes="32x32" dichiarato sopra e scartava l'icona. -->
  <link rel="icon" type="image/png" sizes="96x96" href="/assets/favicon-96.png">
  <link rel="icon" type="image/png" sizes="144x144" href="/assets/favicon-144.png">
  <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">
  <meta name="theme-color" content="#0d1f3c">
  <title>Blog — Glaucoma e salute degli occhi | Dott. Corrado Gizzi</title>
  <meta name="description" content="Articoli sul glaucoma scritti per i pazienti: come si convive con la malattia, cosa aspettarsi dai trattamenti, cosa sapere se un familiare ne soffre.">
  <link rel="canonical" href="https://corradogizzi.it/blog/">
  <meta property="og:site_name" content="Dott. Corrado Gizzi">
  <meta property="og:locale" content="it_IT">
  <meta property="og:title" content="Blog — Glaucoma e salute degli occhi | Dott. Corrado Gizzi">
  <meta property="og:description" content="Articoli sul glaucoma scritti per i pazienti.">
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://corradogizzi.it/blog/">
  <meta property="og:image" content="https://corradogizzi.it/assets/foto.jpg">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Lato:wght@300;400;700&family=Cormorant+Garamond:ital,wght@0,300;1,300;1,400&display=swap">
  <link rel="stylesheet" href="../css/style.css">
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://corradogizzi.it/" },
          { "@type": "ListItem", "position": 2, "name": "Blog", "item": "https://corradogizzi.it/blog/" }
        ]
      },
      {
        "@type": "Blog",
        "@id": "https://corradogizzi.it/blog/#blog",
        "url": "https://corradogizzi.it/blog/",
        "name": "Blog — Glaucoma e salute degli occhi",
        "inLanguage": "it-IT",
        "isPartOf": { "@id": "https://corradogizzi.it/#website" },
        "author": { "@id": "https://corradogizzi.it/#corrado-gizzi" }
      }
    ]
  }
  </script>
</head>
<body>

<section class="page-hero">
  <div class="container">
    <span class="section-label">Approfondimenti</span>
    <h1>Blog</h1>
    <div class="gold-line"></div>
    <p class="lead">Il glaucoma spiegato senza fretta, a chi ci convive</p>
  </div>
</section>

<section class="section section--white">
  <div class="container">
    <div style="max-width:820px;">
      {%- if collections.postsConBozze.length %}
        {%- for post in collections.postsConBozze %}
      <article class="info-card reveal" style="margin-bottom:1.5rem;">
        <div style="font-size:.72rem; letter-spacing:.14em; text-transform:uppercase; color:var(--gold-deep); font-weight:700; margin-bottom:.5rem;">
          {{ post.date | dataItaliana }}{% if post.data.bozza %} · bozza da revisionare{% endif %}
        </div>
        <h2 style="font-size:1.4rem; margin-bottom:.5rem;">
          <a href="{{ post.fileSlug }}/">{{ post.data.title }}</a>
        </h2>
        <p>{{ post.data.descrizione }}</p>
        <p style="margin-top:1rem;">
          <a href="{{ post.fileSlug }}/" style="color:var(--gold-deep); font-weight:700; font-size:.85rem;">Leggi l'articolo →</a>
        </p>
      </article>
        {%- endfor %}
      {%- else %}
      <p>Il primo articolo sta arrivando.</p>
      {%- endif %}
    </div>
  </div>
</section>

<script src="../js/layout.js"></script>
<script src="../js/main.js"></script>
<script>injectLayout('blog', '../');</script>
</body>
</html>
