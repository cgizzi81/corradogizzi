<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <!-- Favicon. Percorsi assoluti dalla radice: valgono uguali per le pagine in
       sottocartella, senza doverci anteporre ../ -->
  <link rel="icon" href="/favicon.ico" sizes="32x32">
  <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">
  <meta name="theme-color" content="#0d1f3c">
  {#- Il titolo dell'articolo è già specifico: aggiungerci il nome del dottore
     sfonderebbe i ~60 caratteri oltre i quali Google tronca. Usa `titoloSeo`
     nel front matter se serve un titolo diverso da quello mostrato in pagina. -#}
  <title>{{ titoloSeo or title }}</title>
  <meta name="description" content="{{ descrizione }}">
  {%- if bozza %}
  {# Articolo non ancora revisionato: resta fuori dagli indici finché Corrado non lo approva. #}
  <meta name="robots" content="noindex, follow">
  {%- endif %}
  <link rel="canonical" href="https://corradogizzi.it/blog/{{ page.fileSlug }}/">
  <meta property="og:site_name" content="Dott. Corrado Gizzi">
  <meta property="og:locale" content="it_IT">
  <meta property="og:title" content="{{ title }}">
  <meta property="og:description" content="{{ descrizione }}">
  <meta property="og:type" content="article">
  <meta property="og:url" content="https://corradogizzi.it/blog/{{ page.fileSlug }}/">
  <meta property="og:image" content="https://corradogizzi.it/assets/foto.jpg">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Lato:wght@300;400;700&family=Cormorant+Garamond:ital,wght@0,300;1,300;1,400&display=swap">
  <link rel="stylesheet" href="../../css/style.css">
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://corradogizzi.it/" },
          { "@type": "ListItem", "position": 2, "name": "Blog", "item": "https://corradogizzi.it/blog/" },
          { "@type": "ListItem", "position": 3, "name": {{ title | dump | safe }}, "item": "https://corradogizzi.it/blog/{{ page.fileSlug }}/" }
        ]
      },
      {
        "@type": "MedicalWebPage",
        "@id": "https://corradogizzi.it/blog/{{ page.fileSlug }}/#webpage",
        "url": "https://corradogizzi.it/blog/{{ page.fileSlug }}/",
        "headline": {{ title | dump | safe }},
        "description": {{ descrizione | dump | safe }},
        "datePublished": "{{ page.date | dataISO }}",
        "dateModified": "{{ page.date | dataISO }}",
        "inLanguage": "it-IT",
        "isPartOf": { "@id": "https://corradogizzi.it/#website" },
        "audience": { "@type": "PeopleAudience", "audienceType": "Pazienti" },
        "author": { "@id": "https://corradogizzi.it/#corrado-gizzi" },
        "lastReviewed": "{{ page.date | dataISO }}",
        "reviewedBy": { "@id": "https://corradogizzi.it/#corrado-gizzi" }
      }
    ]
  }
  </script>
</head>
<body>

<section class="page-hero">
  <div class="container">
    <span class="section-label">Blog</span>
    <h1>{{ title }}</h1>
    <div class="gold-line"></div>
    <p class="lead">{{ descrizione }}</p>
    <p style="color:rgba(255,255,255,.5); font-size:.8rem; letter-spacing:.1em; text-transform:uppercase; margin-top:1rem;">
      {{ page.date | dataItaliana }}
    </p>
  </div>
</section>

{%- if bozza %}
<section class="section section--white" style="padding-bottom:0;">
  <div class="container">
    <div style="max-width:760px;">
      <div class="warning-box">
        <strong>📝 Bozza da revisionare.</strong> Questo articolo non è ancora stato validato
        e non è indicizzato dai motori di ricerca.
      </div>
    </div>
  </div>
</section>
{%- endif %}

<section class="section section--white" style="padding-bottom:0;">
  <div class="container">
    <div style="max-width:760px;">
      <div class="warning-box">
        <strong>⚠️ Avvertenza:</strong> Questo articolo ha scopo informativo e non sostituisce
        la visita specialistica. Per la tua situazione specifica, rivolgiti al tuo oculista.
      </div>
    </div>
  </div>
</section>

<section class="section section--white">
  <div class="container">
    <div class="prose-blog">
      {{ content | safe }}
    </div>
  </div>
</section>

<!-- ══ AUTORE (E-E-A-T) ══ -->
<section class="section section--white" style="padding-top:0;">
  <div class="container">
    <div class="autore">
      <picture>
        <source srcset="../../assets/ritratto.webp" type="image/webp">
        <img src="../../assets/ritratto.jpg" width="200" height="200" loading="lazy" decoding="async"
             class="autore-foto" alt="Dott. Corrado Gizzi">
      </picture>
      <div>
        <div class="autore-label">Scritto e revisionato da</div>
        <div class="autore-nome">Dott. Corrado Gizzi</div>
        <div class="autore-ruolo">Medico Chirurgo · Specialista in Oftalmologia</div>
        <div class="autore-cred">Fellowship in Glaucoma, Moorfields Eye Hospital, Londra (2016&ndash;2019)</div>
        <div class="autore-cred">Responsabile del Servizio di Glaucoma, Ospedale degli Infermi di Faenza</div>
        <div class="autore-cred">Responsabile del Centro del Glaucoma, Ospedale Morgagni-Pierantoni di Forl&igrave;</div>
        <div class="autore-cred">Oltre 20 pubblicazioni scientifiche internazionali</div>
        <div class="autore-meta">
          <span>Ultima revisione: <time datetime="{{ page.date | dataISO }}">{{ page.date | dataItaliana }}</time></span>
          <a href="../../biografia.html">Il percorso completo &rarr;</a>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="section" style="background:linear-gradient(135deg,var(--navy) 0%,var(--navy-mid) 100%); text-align:center;">
  <div class="container">
    <h2 style="color:var(--white); margin-bottom:1rem;">Hai una domanda sul tuo caso?</h2>
    <p style="color:rgba(255,255,255,.65); max-width:520px; margin:0 auto 2.5rem;">
      Le informazioni generali non bastano a decidere. In visita possiamo esaminare
      la tua situazione nel concreto.
    </p>
    <div style="display:flex; gap:1rem; justify-content:center; flex-wrap:wrap;">
      <a href="../../prenota.html" class="btn btn-primary">Prenota una visita</a>
      <a href="../" class="btn btn-white">Tutti gli articoli</a>
    </div>
  </div>
</section>

<script src="../../js/layout.js"></script>
<script src="../../js/main.js"></script>
<script>injectLayout('blog', '../../');</script>
</body>
</html>
