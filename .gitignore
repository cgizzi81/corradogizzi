# Dipendenze: le installa Netlify a ogni build
node_modules/

# Output di Eleventy: generato dalla build, non va versionato.
# I sorgenti del blog stanno in _blog/
blog/

# Cache di Eleventy
.cache/

# Scritto dalla build solo sui deploy di anteprima, per tenerli fuori da Google
_headers

# Credenziali: le variabili SMTP vivono nel pannello Netlify, mai nel repo.
# La radice del sito è pubblicata così com'è (publish = "."), quindi un .env
# committato per sbaglio sarebbe scaricabile da chiunque.
.env
.env.*
!.env.esempio
